# مرحلہ 3 — Supabase کی ترتیبات (مثال)
# اس فائل کو .env.local کے نام سے کاپی کریں اور اصل قدریں لکھیں۔
# .env.local کبھی GitHub پر نہیں جائے گی (یہ .gitignore میں ہے)۔
# خفیہ service_role key یہاں کبھی نہ لکھیں — صرف نیچے والی دو عوامی قدریں۔

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
